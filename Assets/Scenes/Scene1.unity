--- !u!114 &1580
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 88}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f301822a0723ec9f74dc6077b92e3502, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  object1: {fileID: 87}
  object2: {fileID: 118}
  object3: {fileID: 25}
  image1: {fileID: 51}
  text1: {fileID: 1553}
  text2: {fileID: 56}
  text3: {fileID: 84}
  clickAudio: {fileID: 1346}
  audioSourceA: {fileID: 1339}
  audioSourceB: {fileID: 1331}
  dialogueSteps:
  - textContent: Hey! happy birthday sweetheart!
    displayDuration: 3
    showText2: 1
    showText3: 0
    audioClip: {fileID: 8300000, guid: 3e573506fb92ad043a59c15b079cf671, type: 3}
    audioSource: 1
  - textContent: Is the whole neighborhood out there?
    displayDuration: 2
    showText2: 0
    showText3: 1
    audioClip: {fileID: 8300000, guid: bd75066f4aae17f4ebdbc6694f4ef347, type: 3}
    audioSource: 2
  - textContent: You sure you don’t wanna meet anyone? C’mon-
    displayDuration: 3
    showText2: 1
    showText3: 0
    audioClip: {fileID: 8300000, guid: 124ba1b7ba5c82f4ba5128db0535fbf2, type: 3}
    audioSource: 1
  - textContent: I'm fine...
    displayDuration: 2
    showText2: 0
    showText3: 1
    audioClip: {fileID: 8300000, guid: 3af590ea44be6024eac740d49ba3fb38, type: 3}
    audioSource: 2
  - textContent: Our whole crew's here! Book club aunties, Mr.Jenkins from next door.
    displayDuration: 6
    showText2: 1
    showText3: 0
    audioClip: {fileID: 8300000, guid: e669298f5fe71324cbc2dc8172f67a6a, type: 3}
    audioSource: 1
  - textContent: big TEN-year-old boy now, huh?
    displayDuration: 4
    showText2: 1
    showText3: 0
    audioClip: {fileID: 8300000, guid: 28baaec44e09803499cea01133a825be, type: 3}
    audioSource: 1
  - textContent: Smile! Fresh house, fresh start!
    displayDuration: 5
    showText2: 1
    showText3: 0
    audioClip: {fileID: 8300000, guid: 0633eee3d2b9b4347a9b0b2db7138e92, type: 3}
    audioSource: 1
  - textContent: Fresh nagging...
    displayDuration: 2
    showText2: 0
    showText3: 1
    audioClip: {fileID: 8300000, guid: d9858070242ac084e8739f6b65eaa469, type: 3}
    audioSource: 2
